# Для локального запуска: `cp .env.example .env`
# docker-compose.yml читает текущий файл

# Для postgres-контейнера
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance
# Порт, на который БД пробрасывается на хост. Смените, если 5432 занят.
POSTGRES_PORT=5432

# DSN для подключения к БД. При запуске через docker compose значение переопределяется в docker-compose.yml (хост `postgres` вместо `localhost`)
DATABASE_URL=postgres://finance:finance@localhost:5432/finance?sslmode=disable
# Ограничения пула соединений pgx
DB_MAX_CONNS=10
DB_MIN_CONNS=2
# Таймаут на установку соединения и на стартовый ping
DB_CONNECT_TIMEOUT=10s

# Адрес, на котором слушает HTTP-сервер
HTTP_ADDR=:8080
# Порт, на который API пробрасывается на хост
API_PORT=8080

HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
# Время ожидания завершения запроса при SIGTERM
SHUTDOWN_TIMEOUT=15s

# debug | info | warn | error
LOG_LEVEL=info
# json | text
LOG_FORMAT=json
